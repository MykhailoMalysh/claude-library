# ai-sdlc plugin configuration
#
# Copy this file to the root of the project you're working in (not the plugin
# directory) and fill in the real values:
#
#   cp ${CLAUDE_PLUGIN_ROOT}/.env.example .env
#
# .env should be gitignored — these are personal/instance-specific values, not
# something to commit. See references/conventions.md for the full schema and
# which skills read which variable.

# --- Jira ---

# Jira project key for this repository, e.g. EPMPMVISTC.
# Required by: pm-create-ticket, dev-task-start, dev-pr-open, dev-pr-review, dev-impl-plan
JIRA_PROJECT=

# Base URL of your Jira instance, e.g. https://jiraeu.epam.com. This is the
# Jira REST API base used by lib/jira_client.py, and also builds ticket links
# in dev-pr-open's success message.
# Required by: pm-create-ticket, dev-task-start, dev-impl-plan, dev-pr-open, dev-pr-review
JIRA_URL=

# Your Jira account, e.g. first_last@epam.com — the basic-auth username for
# the Jira REST API. Optional where a skill only reads tickets; skills ask
# for an assignee/filter user directly if unset.
# Used by: pm-create-ticket, dev-task-start, dev-impl-plan, dev-pr-open, dev-pr-review
JIRA_USERNAME=

# Jira Personal Access Token — the basic-auth password for the Jira REST API,
# paired with JIRA_USERNAME. Generate one from your Jira account's Personal
# Access Tokens settings.
# Required by: pm-create-ticket, dev-task-start, dev-impl-plan, dev-pr-open, dev-pr-review
JIRA_API_TOKEN=

# The literal Jira status name behind the "In Review" board column for this
# project's workflow (workflows vary — the column isn't always literally
# named "In Review"). Optional but recommended.
# Used by: dev-pr-open
JIRA_IN_REVIEW_STATUS=

# --- Git / Azure DevOps ---

# Short username used in branch names, e.g. mykhailo.
# Required by: dev-task-start, dev-pr-open
GIT_USERNAME=

# Azure DevOps organization, project, and repository names.
# Only needed if this repo's origin remote is Azure DevOps (dev.azure.com /
# *.visualstudio.com) -- dev-pr-open detects the host automatically and uses
# the GitLab vars below instead for GitLab-hosted repos.
# Required by: dev-pr-open, dev-pr-address-comments
# (dev-pr-review uses them only when you explicitly ask it to post a finding.)
ADO_ORG=
ADO_PROJECT=
ADO_REPO=

# Personal Access Token with "Code (Read & Write)" scope.
# Generate at: https://dev.azure.com/{ADO_ORG}/_usersSettings/tokens
# Required by: dev-pr-open, dev-pr-address-comments
ADO_PAT=

# --- GitLab ---

# Base URL of your GitLab instance, e.g. https://git.epam.com. Must be the
# instance root, not a project URL -- a project-path URL 404s into GitLab's
# HTML SAML-redirect page instead of JSON for every API call.
# Used by: dev-pr-review (reads the MR description as requirements; posts
# comments only when you explicitly ask), dev-pr-open (for GitLab-hosted repos).
GITLAB_URL=

# Personal or project access token. `read_api` is enough for dev-pr-review;
# `api` scope is needed for dev-pr-review to post comments or for dev-pr-open
# to check for/create merge requests.
# Used by: dev-pr-review, dev-pr-open (for GitLab-hosted repos)
GITLAB_TOKEN=

# Optional: project path, e.g. group/subgroup/repo. Derived from
# `git remote get-url origin` when unset.
# Used by: dev-pr-review, dev-pr-open (for GitLab-hosted repos)
GITLAB_PROJECT=

# --- Pre-flight ---

# Optional: a single command that replaces the pre-flight plan derived from the
# CI pipeline. Leave unset to have dev-pr-preflight read the pipeline file.
# Used by: dev-pr-preflight, dev-pr-open
PRE_PR_VERIFY_CMD=
